<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaRenamer.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- own surfaces: status bar and panels (result list, table) -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusBarBackground" Color="#FFF3F3F3" />
          <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusBarBackground" Color="#FF1C1C1C" />
          <SolidColorBrush x:Key="PanelBackground" Color="#FF2B2B2B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- dark theme: shades of gray instead of black (darkest: status bar, then window, panels, popups) -->
        <ColorPaletteResources x:Key="Dark"
                               RegionColor="#FF202020"
                               AltHigh="#FF2B2B2B"
                               AltMediumHigh="#CC2B2B2B"
                               AltMedium="#992B2B2B"
                               AltMediumLow="#662B2B2B"
                               AltLow="#332B2B2B"
                               ChromeLow="#FF1C1C1C"
                               ChromeMediumLow="#FF333333"
                               ChromeMedium="#FF3A3A3A"
                               ChromeHigh="#FF4A4A4A"
                               ChromeBlackHigh="#FF1C1C1C"
                               ChromeBlackMedium="#CC1C1C1C"
                               ChromeBlackMediumLow="#991C1C1C"
                               ChromeBlackLow="#661C1C1C" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>
