<Project>
  <!--
    Embeds the TMDB API key into the executable (requirement T-21), as constant EmbeddedTmdbApiKey.Value.
    Source of the key:
      1. the environment variable TMDB_API_KEY (CI: repository secret)
      2. the line TMDB_API_KEY=... in the .env file in the repository root (local development, see .env.example)
    Without a key the constant is empty; the application then needs the environment variable at runtime.
    The generated file lives in obj/ and is never committed.
  -->
  <PropertyGroup>
    <_DotEnvFile>$(MSBuildThisFileDirectory)..\..\.env</_DotEnvFile>
  </PropertyGroup>

  <Target Name="GenerateEmbeddedTmdbApiKey" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- set here, IntermediateOutputPath is not known yet when the project file is evaluated -->
      <_EmbeddedTmdbApiKeyFile>$(IntermediateOutputPath)EmbeddedTmdbApiKey.g.cs</_EmbeddedTmdbApiKeyFile>
      <_TmdbApiKey>$([System.String]::Copy('$(TMDB_API_KEY)').Trim())</_TmdbApiKey>
    </PropertyGroup>

    <ReadLinesFromFile File="$(_DotEnvFile)" Condition="'$(_TmdbApiKey)' == '' And Exists('$(_DotEnvFile)')">
      <Output TaskParameter="Lines" ItemName="_DotEnvLine" />
    </ReadLinesFromFile>

    <PropertyGroup Condition="'$(_TmdbApiKey)' == '' And '@(_DotEnvLine)' != ''">
      <_TmdbApiKey Condition="$([System.String]::Copy('%(_DotEnvLine.Identity)').Trim().StartsWith('TMDB_API_KEY='))">$([System.String]::Copy('%(_DotEnvLine.Identity)').Trim().Substring(13).Trim())</_TmdbApiKey>
    </PropertyGroup>

    <!-- the key is written into C# code: only allow characters of TMDB keys (never print the key itself) -->
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_TmdbApiKey)', '^[A-Za-z0-9._-]*$'))"
           Text="The TMDB API key contains invalid characters." />

    <ItemGroup>
      <_EmbeddedTmdbApiKeyLine Include="// generated by EmbeddedTmdbApiKey.targets, do not edit or commit" />
      <_EmbeddedTmdbApiKeyLine Include="namespace MediaRenamer%3B" />
      <_EmbeddedTmdbApiKeyLine Include="internal static class EmbeddedTmdbApiKey" />
      <_EmbeddedTmdbApiKeyLine Include="{" />
      <_EmbeddedTmdbApiKeyLine Include="    public const string Value = &quot;$(_TmdbApiKey)&quot;%3B" />
      <_EmbeddedTmdbApiKeyLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_EmbeddedTmdbApiKeyFile)" Lines="@(_EmbeddedTmdbApiKeyLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_EmbeddedTmdbApiKeyFile)" />
      <FileWrites Include="$(_EmbeddedTmdbApiKeyFile)" />
    </ItemGroup>

    <Message Importance="high" Condition="'$(_TmdbApiKey)' == ''"
             Text="No TMDB API key found (TMDB_API_KEY or .env): the executable will need the environment variable TMDB_API_KEY at runtime." />
  </Target>
</Project>
