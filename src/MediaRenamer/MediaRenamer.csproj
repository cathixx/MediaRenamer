<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Single-file publish (dotnet publish -p:PublishSingleFile=true): bundle the native libraries (Skia, HarfBuzz, ...)
       and the debug symbols into the executable, so the result is exactly one file. -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Some packages (e.g. SkiaSharp, HarfBuzzSharp on Windows) ship debug symbols of their native libraries, which
       would be published next to the executable (about 100 MB). They are not needed by users. -->
  <Target Name="RemovePackageDebugSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- Size of the self-contained executable (win-x64: 86 MB -> 21 MB):
       - trimming removes unused code of the bundled .NET runtime and libraries. Code that is only reached via
         reflection may be removed as well, so trim warnings must be treated as errors and fixed, not ignored.
       - compression shrinks the bundled assemblies; they are decompressed in memory at startup. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaRenamer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaRenamer.Core\MediaRenamer.Core.csproj" />
  </ItemGroup>

  <Import Project="EmbeddedTmdbApiKey.targets" />
</Project>
