<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:MediaRenamer.Resources"
        x:Class="MediaRenamer.MainWindow"
        Title="MediaRenamer" Width="640" Height="400">
  <DockPanel Margin="16">
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Opacity="0.6" Margin="0,12,0,0"/>
    <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="{x:Static res:Strings.Greeting}" FontSize="28" FontWeight="SemiBold"/>
      <TextBox x:Name="SearchBox" PlaceholderText="{x:Static res:Strings.SearchWatermark}" Width="320"/>
      <CheckBox Content="{x:Static res:Strings.ExampleCheckbox}" IsChecked="True"/>
      <Button x:Name="HelloButton" Content="{x:Static res:Strings.ClickMe}" Click="OnHelloClick"/>
      <TextBlock x:Name="ResultText"/>
    </StackPanel>
  </DockPanel>
</Window>
