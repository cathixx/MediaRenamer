<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:MediaRenamer.Resources"
        x:Class="MediaRenamer.Views.MessageWindow"
        Title="{x:Static res:Strings.Error}"
        Icon="/Assets/icon.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                Margin="0,16,0,0">
      <Button x:Name="YesButton" Content="{x:Static res:Strings.Ok}" MinWidth="80" HorizontalContentAlignment="Center"
              IsDefault="True" Classes="accent" Click="OnYes" />
      <Button x:Name="NoButton" MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" IsVisible="False"
              Click="OnNo" />
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock x:Name="HeaderText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
      <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</Window>
